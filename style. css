* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Poppins', sans-serif;
}

body {
    background-color: #050b14;
    color: #ffffff;
    overflow-x: hidden;
}

/* Navbar */
.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 50px;
    background-color: #050b14;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 18px;
    color: #3b82f6;
}

.logo i {
    font-size: 20px;
}

.nav-links {
    list-style: none;
    display: flex;
    gap: 25px;
}

.nav-links a {
    text-decoration: none;
    color: #94a3b8;
    font-size: 14px;
    font-weight: 500;
    transition: 0.3s;
}

.nav-links a:hover, .nav-links a.active {
    color: #ffffff;
}

.nav-links a.active {
    border-bottom: 2px solid #3b82f6;
    padding-bottom: 4px;
}

/* Hero Section */
.hero-section {
    position: relative;
    background: linear-gradient(rgba(5, 11, 20, 0.6), rgba(5, 11, 20, 0.9)), url('bg-airplane.jpg') no-repeat center center/cover;
    /* குறிப்பு: விமானம் மற்றும் சூரிய அஸ்தமனம் உள்ள பேக்ரவுண்ட் படத்திற்கு 'bg-airplane.jpg' என பெயரிடலாம் */
    padding: 80px 50px;
    min-height: 500px;
    display: flex;
    align-items: center;
}

.hero-content {
    display: flex;
    align-items: center;
    gap: 60px;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
}

.profile-container {
    width: 250px;
    height: 250px;
    border-radius: 50%;
    border: 4px solid #3b82f6;
    overflow: hidden;
    box-shadow: 0 0 25px rgba(59, 130, 246, 0.4);
    flex-shrink: 0;
}

.profile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.intro-text .greeting {
    font-size: 28px;
    color: #ffffff;
    font-weight: 300;
    font-style: italic;
}

.intro-text h1 {
    font-size: 42px;
    font-weight: 700;
    margin: 5px 0;
}

.highlight {
    color: #3b82f6;
}

.tagline {
    font-size: 16px;
    color: #94a3b8;
    margin-bottom: 15px;
    letter-spacing: 1px;
}

.dot {
    color: #3b82f6;
    margin: 0 5px;
}

.location {
    font-size: 14px;
    color: #cbd5e1;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.location i {
    color: #3b82f6;
}

.quote {
    font-style: italic;
    color: #94a3b8;
    font-size: 15px;
    border-left: 3px solid #3b82f6;
    padding-left: 12px;
    line-height: 1.5;
}

.quote i {
    color: #3b82f6;
    font-size: 12px;
    margin-left: 5px;
}

/* About Section */
.about-section {
    background-color: #07101e;
    padding: 80px 50px;
}

.about-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    gap: 50px;
    align-items: flex-start;
}

.about-text-box {
    flex: 1.2;
}

.about-text-box h2 {
    font-size: 32px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 12px;
}

.about-text-box h2 i {
    color: #3b82f6;
    font-size: 28px;
}

.about-text-box p {
    color: #94a3b8;
    line-height: 1.8;
    font-size: 15px;
    margin-bottom: 20px;
}

.cursive-quote {
    font-family: 'Brush Script MT', cursive, sans-serif;
    font-size: 26px;
    color: #3b82f6 !important;
    margin-top: 30px;
}

/* About Card Right */
.about-card {
    flex: 1;
    background-color: #0b1629;
    border: 1px solid rgba(59, 130, 246, 0.2);
    border-radius: 16px;
    padding: 25px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
}

.card-item {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 15px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.card-item:last-child {
    border-bottom: none;
}

.card-item i {
    font-size: 22px;
    color: #3b82f6;
    width: 30px;
    text-align: center;
}

.card-item .label {
    display: block;
    font-size: 12px;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.card-item .value {
    font-size: 14px;
    color: #ffffff;
    font-weight: 500;
}

/* Footer Nav Icons */
.footer-nav {
    background-color: #040811;
    padding: 40px 50px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    text-align: center;
}

.footer-item {
    padding: 20px;
    border-radius: 10px;
    transition: 0.3s;
}

.footer-item:hover {
    background-color: rgba(59, 130, 246, 0.05);
}

.footer-item i {
    font-size: 24px;
    color: #3b82f6;
    margin-bottom: 10px;
}

.footer-item h3 {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 5px;
    color: #ffffff;
}

.footer-item p {
    font-size: 12px;
    color: #64748b;
}
